{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "rootDir": "src/ts",
    "outDir": "dist/js"
  },
  "include": [
    "src/ts/**/*.ts"
  ],
  "exclude": [
    "src/ts/hero3d/**"
  ]
}
